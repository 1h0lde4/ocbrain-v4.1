  {
    "url": "https://api.github.com/repos/1h0lde4/ocbrain-v4.1/pulls/73",
    "id": 4810509939,
    "node_id": "PR_kwDOSWs39c8AAAABHrqOcw",
    "html_url": "https://github.com/1h0lde4/ocbrain-v4.1/pull/73",
    "diff_url": "https://github.com/1h0lde4/ocbrain-v4.1/pull/73.diff",
