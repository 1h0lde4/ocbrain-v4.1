    "number": 109,
    "state": "open",
    "locked": false,
    "title": "docs(adr-kernel-08): record owner acceptance of §8.1 item 1, verified chronology and evidence scope",
    "user": {
      "login": "1h0lde4",
      "id": 196927701,
      "node_id": "U_kgDOC7zg1Q",
      "avatar_url": "https://avatars.githubusercontent.com/u/196927701?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/1h0lde4",
      "html_url": "https://github.com/1h0lde4",
