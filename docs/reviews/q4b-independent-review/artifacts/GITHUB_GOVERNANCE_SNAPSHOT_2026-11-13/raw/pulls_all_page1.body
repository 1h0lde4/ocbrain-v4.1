    "title": "docs: close DEBT-037 against PR #63 and record the DEBT-032 embedded-only boundary",
    "user": {
      "login": "1h0lde4",
      "id": 196927701,
      "node_id": "U_kgDOC7zg1Q",
      "avatar_url": "https://avatars.githubusercontent.com/u/196927701?v=4",
