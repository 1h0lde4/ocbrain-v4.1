    "title": "docs: correct DEBT-020 prior-art branch retention claim (ADR-KERNEL-04, KNOWN_ISSUES, CURRENT_STATE)",
    "user": {
      "login": "1h0lde4",
      "id": 196927701,
      "node_id": "U_kgDOC7zg1Q",
