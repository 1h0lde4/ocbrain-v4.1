  {
    "url": "https://api.github.com/repos/1h0lde4/ocbrain-v4.1/pulls/6",
    "id": 4265164587,
    "node_id": "PR_kwDOSWs39c7-OT8r",
    "html_url": "https://github.com/1h0lde4/ocbrain-v4.1/pull/6",
    "diff_url": "https://github.com/1h0lde4/ocbrain-v4.1/pull/6.diff",
    "patch_url": "https://github.com/1h0lde4/ocbrain-v4.1/pull/6.patch",
    "issue_url": "https://api.github.com/repos/1h0lde4/ocbrain-v4.1/issues/6",
    "number": 6,
    "state": "closed",
    "locked": false,
    "title": "Cross-Platform GitHub Release Automation on Version Tags",
    "user": {
      "login": "1h0lde4",
      "id": 196927701,
      "node_id": "U_kgDOC7zg1Q",
      "avatar_url": "https://avatars.githubusercontent.com/u/196927701?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/1h0lde4",
      "html_url": "https://github.com/1h0lde4",
      "followers_url": "https://api.github.com/users/1h0lde4/followers",
      "following_url": "https://api.github.com/users/1h0lde4/following{/other_user}",
      "gists_url": "https://api.github.com/users/1h0lde4/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/1h0lde4/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/1h0lde4/subscriptions",
      "organizations_url": "https://api.github.com/users/1h0lde4/orgs",
      "repos_url": "https://api.github.com/users/1h0lde4/repos",
      "events_url": "https://api.github.com/users/1h0lde4/events{/privacy}",
      "received_events_url": "https://api.github.com/users/1h0lde4/received_events",
      "type": "User",
      "user_view_type": "public",
      "site_admin": false
    },
    "body": "This PR implements automatic cross-platform binary packaging and GitHub release publishing when a version tag (e.g. `v1.2.3`) is pushed to the repository.\n\nFeatures:\n- **Linux**: Standalone ELF binary (`ocbrain-linux-amd64`), `.deb` package, `.rpm` spec, and Arch AUR `PKGBUILD`.\n- **Windows**: Standalone PE binary (`ocbrain-windows-amd64.exe`) and an installer (`ocbrain-VERSION-setup.exe` via NSIS).\n- **macOS**: Standalone Mach-O binary (`ocbrain-macos-amd64`), automated installation package (`ocbrain-macos.pkg` via pkgbuild), and a Homebrew Tap Formula (`ocbrain.rb`).\n- **Android**: A highly portable and fully compatible Termux bootstrap archive (`ocbrain-android-termux.tar.gz`) along with an experimental APK compilation step via python-for-android.\n\nAdditionally, `install/build.py` has been modernized with cross-platform separator support and a smart clean system that allows sequential single-target builds.\n\n---\n*PR created automatically by Jules for task [13854394181023180941](https://jules.google.com/task/13854394181023180941) started by @1h0lde4*",
    "created_at": "2026-08-12T19:00:28Z",
    "updated_at": "2026-08-17T07:41:21Z",
