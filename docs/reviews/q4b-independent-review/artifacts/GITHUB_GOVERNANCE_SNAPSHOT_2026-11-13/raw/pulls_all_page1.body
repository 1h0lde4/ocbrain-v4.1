    "title": "[DRAFT][Batch 1A] R-1 hardening — diagnostic CI run only (NOT for merge; 667cb94 review: NOT APPROVED)",
    "user": {
      "login": "1h0lde4",
      "id": 196927701,
      "node_id": "U_kgDOC7zg1Q",
      "avatar_url": "https://avatars.githubusercontent.com/u/196927701?v=4",
