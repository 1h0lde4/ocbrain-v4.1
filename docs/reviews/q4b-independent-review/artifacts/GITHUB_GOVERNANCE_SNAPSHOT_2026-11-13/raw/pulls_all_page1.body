    "locked": false,
    "title": "docs(register): DEBT-033 live enforce_admins=true; link DEBT-030 <-> FZ-06",
    "user": {
      "login": "1h0lde4",
      "id": 196927701,
      "node_id": "U_kgDOC7zg1Q",
