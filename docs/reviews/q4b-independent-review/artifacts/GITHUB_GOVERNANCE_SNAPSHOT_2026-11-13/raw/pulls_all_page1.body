    "title": "ADR-KERNEL-07: creative content-anchor detector, slice 1 (PROPOSED; flag OFF)",
    "user": {
      "login": "1h0lde4",
      "id": 196927701,
      "node_id": "U_kgDOC7zg1Q",
      "avatar_url": "https://avatars.githubusercontent.com/u/196927701?v=4",
