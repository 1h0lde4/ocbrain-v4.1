    "title": "fix(ci): gate on pytest exit code, errors and empty runs (FZ-07 / B9)",
    "user": {
      "login": "1h0lde4",
      "id": 196927701,
      "node_id": "U_kgDOC7zg1Q",
      "avatar_url": "https://avatars.githubusercontent.com/u/196927701?v=4",
