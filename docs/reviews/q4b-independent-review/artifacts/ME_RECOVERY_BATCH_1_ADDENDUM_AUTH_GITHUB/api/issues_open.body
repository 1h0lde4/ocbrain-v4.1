    "updated_at": "2026-11-02T11:23:53Z",
    "closed_at": null,
    "assignee": null,
    "author_association": "OWNER",
    "issue_field_values": [

    ],
    "type": null,
    "active_lock_reason": null,
    "sub_issues_summary": {
      "total": 0,
      "completed": 0,
