    "pull_request": {
      "url": "https://api.github.com/repos/1h0lde4/ocbrain-v4.1/pulls/94",
      "html_url": "https://github.com/1h0lde4/ocbrain-v4.1/pull/94",
      "diff_url": "https://github.com/1h0lde4/ocbrain-v4.1/pull/94.diff",
      "patch_url": "https://github.com/1h0lde4/ocbrain-v4.1/pull/94.patch",
