    "number": 105,
    "title": "Worker.execute() turns task cancellation into a failed result; the workflow retries instead of stopping",
    "user": {
      "login": "1h0lde4",
      "id": 196927701,
      "node_id": "U_kgDOC7zg1Q",
      "avatar_url": "https://avatars.githubusercontent.com/u/196927701?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/1h0lde4",
      "html_url": "https://github.com/1h0lde4",
      "followers_url": "https://api.github.com/users/1h0lde4/followers",
      "following_url": "https://api.github.com/users/1h0lde4/following{/other_user}",
      "gists_url": "https://api.github.com/users/1h0lde4/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/1h0lde4/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/1h0lde4/subscriptions",
